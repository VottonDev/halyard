# Maintainer: Otto Hooper <votton@users.noreply.github.com>
pkgname=halyard
pkgver=@VERSION@
pkgrel=1
pkgdesc='Unofficial two-way Proton Drive sync client for GNOME'
arch=('any')
url='https://github.com/VottonDev/halyard'
license=('MIT' 'GPL-3.0-only' 'LGPL-3.0-or-later' 'Apache-2.0' 'BSD-3-Clause' 'ISC' 'BlueOak-1.0.0')
depends=('nodejs>=22.13' 'python' 'python-gobject' 'gtk4>=4.10' 'libadwaita>=1.6'
         'bash' 'glib2' 'gdk-pixbuf2' 'hicolor-icon-theme' 'dconf'
         'dbus' 'gnome-keyring' 'xdg-desktop-portal' 'ca-certificates' 'gst-plugins-base' 'gst-plugins-good')
makedepends=('git' 'bun' 'nodejs>=22.15')
optdepends=('xdg-desktop-portal-gnome: GNOME background and file chooser portals'
            'gst-libav: additional video codecs, including H.264 and HEVC')
# Do not byte-compile Python for the builder's interpreter or strip JS assets.
options=('!strip' '!debug')
# Generated from the release checkout; commits cannot be retargeted like tags.
_commit=@COMMIT@
source=("git+$url.git#commit=$_commit"
        'proton-sdk::git+https://github.com/ProtonDriveApps/sdk.git#commit=28ac9cdc258737375692d1751dd9c7edcfb96708')
sha256sums=('SKIP' 'SKIP')

prepare() {
    cd "$srcdir/halyard"
    git submodule init proton-sdk
    git config submodule.proton-sdk.url "$srcdir/proton-sdk"
    git -c protocol.file.allow=always submodule update proton-sdk
}

build() {
    cd "$srcdir/halyard"
    BUN_INSTALL_CACHE_DIR="$srcdir/bun-cache" ./packaging/build.sh
}

check() {
    cd "$srcdir/halyard"
    (cd daemon && bun run test)
    PYTHONPATH=ui python -m unittest discover -s ui/tests -p 'test_*.py'
    PYTHONPATH=ui python -m unittest discover -s packaging/tests
}

package() {
    cd "$srcdir/halyard"
    python packaging/stage.py --destdir "$pkgdir" --package-name "$pkgname"
}
